# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Workspace-specific ignores (Next.js build output, codegen, coverage, etc.)
# live in apps/frontend/.gitignore.

# dependencies (covers root + nested workspace node_modules)
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!apps/backend/.env.example

# test artifacts
coverage/
**/coverage/
**/__snapshots__/
**/test_snapshots/
*.snap
junit.xml
**/junit.xml

# IDE / editor
.idea/
.vscode/
*.iml
*.suo
*.user
.project
.classpath

# OS
.DS_Store
*.pem

# Next.js / build output (workspace-level, belt-and-suspenders)
**/.next/
**/out/
**/build/

# typescript incremental build info
*.tsbuildinfo

# rust / soroban contracts build output
**/target/
